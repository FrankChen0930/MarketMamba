{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:marketmamba:synthetic-ranking-evaluation-v1",
  "title": "Window08 stable engineering output, NOT ADMITTED research policy",
  "type": "object",
  "required": [
    "schema",
    "status",
    "research_admitted",
    "daily",
    "records",
    "requested",
    "rejections",
    "summary",
    "periods"
  ],
  "properties": {
    "schema": {
      "const": "v7-ranking-evaluation-v1"
    },
    "status": {
      "enum": [
        "REJECTED",
        "EVALUATED",
        "NO_ELIGIBLE_SESSIONS"
      ]
    },
    "research_admitted": {
      "const": false
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "signal_session",
          "horizon",
          "valid_n",
          "rank_ic",
          "reasons",
          "stock_ids",
          "support_sha256",
          "evaluation_identity",
          "requested_n",
          "excluded_n"
        ],
        "properties": {
          "rank_ic": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -1.000000000000001,
            "maximum": 1.000000000000001
          },
          "valid_n": {
            "type": "integer",
            "minimum": 0
          },
          "requested_n": {
            "type": "integer",
            "minimum": 0
          },
          "excluded_n": {
            "type": "integer",
            "minimum": 0
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stock_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "support_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evaluation_identity": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "stock_id",
              "signal_session",
              "horizon",
              "label_id",
              "label_metadata_sha256"
            ],
            "properties": {
              "stock_id": {
                "type": "string",
                "minLength": 1
              },
              "signal_session": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "horizon": {
                "type": "integer",
                "minimum": 1
              },
              "label_id": {
                "type": "string",
                "minLength": 1
              },
              "label_metadata_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "score",
              "label",
              "label_metadata"
            ],
            "properties": {
              "score": {
                "type": "number"
              },
              "label": {
                "type": "number"
              },
              "label_metadata": {
                "type": "object",
                "required": [
                  "source_sha256",
                  "snapshot_sha256",
                  "payload_sha256",
                  "vintage_id",
                  "label_contract_id",
                  "available_at",
                  "mature_at",
                  "eligibility_status",
                  "eligibility_ref"
                ]
              }
            }
          }
        ]
      }
    },
    "requested": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stock_id",
          "signal_session",
          "horizon",
          "label_id",
          "label_metadata_sha256"
        ],
        "properties": {
          "stock_id": {
            "type": "string",
            "minLength": 1
          },
          "signal_session": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "horizon": {
            "type": "integer",
            "minimum": 1
          },
          "label_id": {
            "type": "string",
            "minLength": 1
          },
          "label_metadata_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "stock_id",
              "signal_session",
              "horizon",
              "label_id",
              "label_metadata_sha256"
            ],
            "properties": {
              "stock_id": {
                "type": "string",
                "minLength": 1
              },
              "signal_session": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "horizon": {
                "type": "integer",
                "minimum": 1
              },
              "label_id": {
                "type": "string",
                "minLength": 1
              },
              "label_metadata_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "reasons"
            ],
            "properties": {
              "reasons": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "by_horizon"
      ],
      "properties": {
        "by_horizon": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "periods": {
      "type": "array"
    },
    "evaluation_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "calendar_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fold_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "header": {
      "type": "object",
      "required": [
        "study_id",
        "recipe_id",
        "run_id",
        "fold_id",
        "origin_at",
        "model_sha256",
        "source_sha256",
        "snapshot_sha256",
        "vintage_id",
        "sessions",
        "horizons",
        "raw_predictions_ref",
        "prediction_role",
        "evaluation_role",
        "evaluation_at"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "EVALUATED",
              "NO_ELIGIBLE_SESSIONS"
            ]
          }
        }
      },
      "then": {
        "required": [
          "evaluation_identity",
          "input_sha256",
          "policy_sha256",
          "calendar_sha256",
          "fold_sha256",
          "label_contract_id",
          "header",
          "policy"
        ]
      }
    }
  ],
  "$comment": "All data synthetic; hashes are identities, not proof of source retention/authenticity. Full raw predictions must be separately retained by future tracking. No cross-horizon pooling."
}
